{
  "name": "terzocloud-asset-portal",
  "version": "1.0.0",
  "description": "IT Asset & Software Management Portal for TerzoCloud",
  "main": "server.js",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "seed": "node db/seed.js",
    "seed:software": "node db/seed.js --force-software",
    "seed:safe": "node db/seed.js --safe",
    "seed:safe:software": "node db/seed.js --safe --force-software",
    "seed:docker": "docker compose exec app node db/seed.js",
    "seed:docker:safe": "docker compose exec app node db/seed.js --safe",
    "db:backup": "./scripts/db-backup.sh",
    "db:restore": "./scripts/db-restore.sh"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.4",
    "nodemailer": "^8.0.2"
  },
  "devDependencies": {
    "eslint": "^10.0.3",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
